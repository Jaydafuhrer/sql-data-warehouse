/*
============================================================
SILVER LAYER DATA QUALITY CHECKS
Run these queries after loading data into the silver layer.
Queries that check errors should return no rows or a count of 0.
============================================================
*/

USE real_data_warehouse_silver;


-- ==========================================================
-- 1. CHECK THAT ALL SILVER TABLES CONTAIN DATA
-- ==========================================================

SELECT 'crm_cust_info' AS table_name, COUNT(*) AS row_count
FROM real_silver_crm_cust_info
UNION ALL
SELECT 'crm_prd_info', COUNT(*)
FROM real_silver_crm_prd_info
UNION ALL
SELECT 'crm_sale_details', COUNT(*)
FROM real_silver_crm_sale_details
UNION ALL
SELECT 'erp_cust_az12', COUNT(*)
FROM real_silver_erp_cust_az12
UNION ALL
SELECT 'erp_loc_a101', COUNT(*)
FROM real_silver_erp_loc_a101
UNION ALL
SELECT 'erp_px_cat_g1v2', COUNT(*)
FROM real_silver_erp_px_cat_g1v2;


-- ==========================================================
-- 2. CUSTOMER TABLE CHECKS
-- ==========================================================

-- Check for missing or invalid customer IDs.
SELECT *
FROM real_silver_crm_cust_info
WHERE cst_id IS NULL OR cst_id <= 0;

-- Check for duplicate customer IDs.
SELECT cst_id, COUNT(*) AS record_count
FROM real_silver_crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1;

-- Review standardized marital status and gender values.
SELECT DISTINCT cst_marital_status
FROM real_silver_crm_cust_info;

SELECT DISTINCT cst_gender
FROM real_silver_crm_cust_info;


-- ==========================================================
-- 3. PRODUCT TABLE CHECKS
-- ==========================================================

-- Check for duplicate product IDs.
SELECT prd_id, COUNT(*) AS record_count
FROM real_silver_crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1;

-- Check for missing product information or negative costs.
SELECT *
FROM real_silver_crm_prd_info
WHERE prd_id IS NULL
   OR prd_key IS NULL
   OR prd_cost IS NULL
   OR prd_cost < 0;

-- Review standardized product-line values.
SELECT DISTINCT prd_line
FROM real_silver_crm_prd_info;

-- Check for invalid product date ranges.
SELECT prd_id, prd_key, prd_start_date, prd_end_date
FROM real_silver_crm_prd_info
WHERE prd_start_date > prd_end_date;


-- ==========================================================
-- 4. SALES TABLE CHECKS
-- ==========================================================

-- Check for missing sales identifiers.
SELECT *
FROM real_silver_crm_sale_details
WHERE sls_order_num IS NULL
   OR sls_prod_key IS NULL
   OR sls_cust_id IS NULL;

-- Check for invalid sales, quantity, or price values.
SELECT *
FROM real_silver_crm_sale_details
WHERE sls_sales IS NULL OR sls_sales <= 0
   OR sls_quantity IS NULL OR sls_quantity <= 0
   OR sls_price IS NULL OR sls_price <= 0;

-- Check that sales equals quantity multiplied by price.
SELECT
    sls_order_num,
    sls_sales,
    sls_quantity,
    sls_price,
    sls_quantity * ABS(sls_price) AS expected_sales
FROM real_silver_crm_sale_details
WHERE ABS(sls_sales - (sls_quantity * ABS(sls_price))) > 0.01;

-- Check that sales dates follow the correct order.
SELECT *
FROM real_silver_crm_sale_details
WHERE sls_order_date > sls_ship_date
   OR sls_ship_date > sls_due_date;


-- ==========================================================
-- 5. ERP TABLE CHECKS
-- ==========================================================

-- Check ERP customer birth dates and gender values.
SELECT *
FROM real_silver_erp_cust_az12
WHERE birth_date > '2022-12-31'
   OR birth_date < '1900-12-31';

SELECT DISTINCT gender
FROM real_silver_erp_cust_az12;

-- Check that location IDs no longer contain hyphens.
SELECT *
FROM real_silver_erp_loc_a101
WHERE CID LIKE '%-%';

-- Review the standardized country values.
SELECT country, COUNT(*) AS record_count
FROM real_silver_erp_loc_a101
GROUP BY country
ORDER BY record_count DESC;

-- Check that category IDs no longer contain underscores.
SELECT *
FROM real_silver_erp_px_cat_g1v2
WHERE LOCATE('_', ID) > 0;


-- ==========================================================
-- 6. RELATIONSHIP CHECKS
-- ==========================================================

-- Find sales records with no matching customer.
SELECT sales.*
FROM real_silver_crm_sale_details AS sales
LEFT JOIN real_silver_crm_cust_info AS customers
    ON sales.sls_cust_id = customers.cst_id
WHERE customers.cst_id IS NULL;

-- Find sales records with no matching product.
SELECT sales.*
FROM real_silver_crm_sale_details AS sales
LEFT JOIN real_silver_crm_prd_info AS products
    ON sales.sls_prod_key = products.prd_key_standalone
WHERE products.prd_key_standalone IS NULL;

-- Find products with no matching ERP category.
SELECT products.prd_id, products.prd_key, products.category_id
FROM real_silver_crm_prd_info AS products
LEFT JOIN real_silver_erp_px_cat_g1v2 AS categories
    ON products.category_id = categories.ID
WHERE categories.ID IS NULL;

