-- Load cleaned ERP customer-location data.
INSERT INTO real_data_warehouse_silver.real_silver_erp_loc_a101 (
    CID ,
    country 
    
)
SELECT
    REPLACE(TRIM(CID), '-', '') AS CID,
    

    CASE
        WHEN UPPER(TRIM(REPLACE(country, CHAR(13), '')))
             IN ('DE', 'GERMANY')
        THEN 'Germany'

        WHEN UPPER(TRIM(REPLACE(country, CHAR(13), '')))
             IN ('US', 'USA', 'UNITED STATES')
        THEN 'United States'

        WHEN TRIM(REPLACE(country, CHAR(13), '')) = ''
        THEN 'Unknown'
        
      

        ELSE TRIM(REPLACE(country, CHAR(13), ''))
    END AS country

FROM real_erp_loc_a101
; 



