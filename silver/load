-- Load cleaned ERP customer data.
INSERT INTO  real_data_warehouse_silver.real_silver_erp_cust_az12 (
    CID ,
    birth_date,
    gender 
   
)
SELECT 

CASE
	WHEN CID LIKE 'NAS%' THEN SUBSTRING(CID,4,1000)
    ELSE CID
END AS CID,

CASE
	WHEN birth_date > '2022-12-31' OR birth_date < '1900-12-31' THEN NULL
    ELSE birth_date
END AS birth_date,

CASE
    WHEN UPPER(
        TRIM(
            REPLACE(
                REPLACE(gender, CHAR(13), ''),
                CHAR(10), ''
            )
        )
    ) IN ('F', 'FEMALE')
    THEN 'Female'

    WHEN UPPER(
        TRIM(
            REPLACE(
                REPLACE(gender, CHAR(13), ''),
                CHAR(10), ''
            )
        )
    ) IN ('M', 'MALE')
    THEN 'Male'

    ELSE 'Unknown'
END AS gender
FROM real_erp_cust_az12

;



