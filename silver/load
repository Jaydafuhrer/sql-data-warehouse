-- Load cleaned CRM product data.
INSERT INTO real_data_warehouse_silver.real_silver_crm_prd_info (
    prd_id,
    prd_key,
    category_id,
    prd_key_standalone,
    prd_name,
    prd_cost,
    prd_line,
    prd_start_date,
    prd_end_date
);

-- Normalize product text, costs, codes, and raw date values.
WITH normalized AS (
    SELECT
        prd_id,
        TRIM(prd_key) AS prd_key,
        TRIM(prd_name) AS prd_name,

        CAST(
            COALESCE(NULLIF(TRIM(prd_cost), ''), '0')
            AS DECIMAL(12,2)
        ) AS prd_cost,

        UPPER(TRIM(prd_line)) AS prd_line,

        TRIM(
            REPLACE(
                REPLACE(
                    REPLACE(prd_start_date, CHAR(13), ''),
                    CHAR(10), ''
                ),
                CHAR(9), ''
            )
        ) AS start_date_text,

        TRIM(
            REPLACE(
                REPLACE(
                    REPLACE(prd_end_date, CHAR(13), ''),
                    CHAR(10), ''
                ),
                CHAR(9), ''
            )
        ) AS end_date_text

    FROM real_crm_prd_info
),

-- Validate and convert dates in YYYY-MM-DD format.
cleaned AS (
    SELECT
        prd_id,
        prd_key,
        prd_name,
        prd_cost,
        prd_line,

        CASE
            WHEN start_date_text IS NULL
                 OR start_date_text = ''
            THEN NULL
            WHEN start_date_text REGEXP
                 '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            THEN STR_TO_DATE(start_date_text, '%Y-%m-%d')
            ELSE NULL
        END AS clean_start_date,

        CASE
            WHEN end_date_text IS NULL
                 OR end_date_text = ''
            THEN NULL
            WHEN end_date_text REGEXP
                 '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            THEN STR_TO_DATE(end_date_text, '%Y-%m-%d')
            ELSE NULL
        END AS clean_end_date

    FROM normalized
),

-- Find each product's next start date to help correct invalid end dates.
sequenced AS (
    SELECT
        *,
        LEAD(clean_start_date) OVER (
            PARTITION BY SUBSTRING(prd_key, 7)
            ORDER BY clean_start_date
        ) AS next_start_date
    FROM cleaned
)

SELECT
    prd_id,
    prd_key,

    SUBSTRING(prd_key, 1, 5) AS category_id,

    SUBSTRING(prd_key, 7) AS prd_key_standalone,
    prd_name,
    prd_cost,

    CASE
        WHEN prd_line = 'R' THEN 'Road'
        WHEN prd_line = 'S' THEN 'Other sales'
        WHEN prd_line = 'M' THEN 'Mountain'
        WHEN prd_line = 'T' THEN 'Touring'
        ELSE 'Unknown'
    END AS prd_line,

    clean_start_date,

    CASE
        WHEN clean_start_date > clean_end_date
             AND next_start_date IS NOT NULL
        THEN DATE_SUB(next_start_date, INTERVAL 1 DAY)
        ELSE clean_end_date
    END AS prd_end_date

FROM sequenced;


